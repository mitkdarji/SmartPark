# ─────────────────────────────────────────────────────────────
# SmartPark — environment configuration
# Copy to .env and fill in. Every AI key is OPTIONAL: the platform
# degrades to deterministic local engines when a key is absent.
# ─────────────────────────────────────────────────────────────

APP_ENV=development
APP_NAME=SmartPark
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite by default; swap for Postgres in cloud) ---
DATABASE_URL=sqlite+aiosqlite:///./data/smartpark.db
# DATABASE_URL=postgresql+asyncpg://smartpark:smartpark@localhost:5432/smartpark

# --- Cache / queue (optional; falls back to in-process) ---
REDIS_URL=

# --- Generative AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=
GENAI_MODEL=claude-opus-5
GENAI_FAST_MODEL=claude-haiku-4-5
GENAI_MAX_TOKENS=2048

# --- Computer Vision / ANPR ---
# ocr_backends: ordered ensemble. Any subset of: easyocr,tesseract,vision_llm,synthetic
ANPR_OCR_BACKENDS=easyocr,tesseract,vision_llm,synthetic
ANPR_MIN_CONFIDENCE=0.55
ANPR_PLATE_REGION=IN

# --- Voice AI ---
# stt_backend: whisper_local | faster_whisper | none
VOICE_STT_BACKEND=faster_whisper
VOICE_TTS_BACKEND=pyttsx3

# --- Payments (mock wallet is default; adapter is pluggable) ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# --- Third-party integrations ---
OPENWEATHER_API_KEY=
MAPS_PROVIDER=osm
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Smart-city open data feed ---
CITY_FEED_ENABLED=true
CITY_FEED_OPERATOR_ID=pdeu-smartpark-001

# --- Automation scheduler ---
AUTOMATION_ENABLED=true
AUTOMATION_TICK_SECONDS=60
